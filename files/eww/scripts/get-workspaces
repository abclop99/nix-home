#!/usr/bin/env bash

# The 1-10 list, each carrying the monitor that owns it. hyprctl only reports
# workspaces that exist, and Hyprland destroys an empty one unless it is some
# monitor's active workspace -- so a workspace missing from its output has no
# owner, and any bar may claim it.
spaces (){
  WORKSPACES=$(hyprctl workspaces -j | jaq 'map({key: (.id|tostring), value: .monitor}) | from_entries')
  seq 1 10 | jaq --arg ws "${WORKSPACES}" --slurp -c 'map(tostring) | map({id: ., monitor: (($ws|fromjson)[.] // "")})'
}

spaces
# Only the events that can change a workspace's owner. Window activity cannot:
# a workspace coming into or going out of existence fires create/destroyworkspace,
# and a cross-monitor move fires moveworkspace. The monitor events matter because
# this list carries ownership -- an unplug migrates workspaces, and without them
# the indicator would keep naming a monitor that is gone.
socat -u UNIX-CONNECT:$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock - | while read -r line; do
  case $line in
    createworkspace*|destroyworkspace*|moveworkspace*|monitoradded*|monitorremoved*) spaces ;;
  esac
done
