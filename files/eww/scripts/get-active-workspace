#!/usr/bin/env bash

# Monitor name -> active workspace id. eww variables are global, so each bar
# indexes this map by its own monitor name instead of tracking the focused one.
active (){
  hyprctl monitors -j | jaq -c 'map({key: .name, value: .activeWorkspace.id}) | from_entries'
}

active
# Only the events that can change which workspace a monitor is showing. Window
# activity does not, so the activewindow stream is skipped here.
socat -u UNIX-CONNECT:$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock - | while read -r line; do
  case $line in
    workspace*|moveworkspace*|focusedmon*|monitoradded*|monitorremoved*) active ;;
  esac
done
