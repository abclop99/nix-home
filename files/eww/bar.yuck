; Includes
(include "./hyprland.yuck")
(include "./controls.yuck")
(include "./system.yuck")
(include "./clock.yuck")

; Overall widget. `screen` is the monitor name this bar belongs to. The left
; and center sections are per-monitor; the right is mostly global, but takes
; `screen` too, because brightness belongs to one display rather than to the
; session.
(defwidget bar [screen]
	(centerbox  :orientation "horizontal"
							:halign "fill"
		(left :screen screen)
		(center :screen screen)
		(right :screen screen)
	)
)

; Left, center, right sections
(defwidget left [screen]
	(box  :orientation "h"
				:space-evenly false
				:halign "start"
				:class "section left"

		(workspaces :screen screen)
	)
)

(defwidget center [screen]
	(box  :orientation "h"
				:space-evenly false
				:halign "center"
				:class "section center ${(window_titles?.[screen] ?: "") == "" ? "empty" : "occupied" }"

		(active_window :screen screen)
	)
)

(defwidget right [screen]
	(box  :orientation "h"
				:space-evenly false
				:halign "end"
				:class "section right"

		(systray
			:orientation 'h'
		)
		(sep)
		(controls :screen screen)
		(sep)
		(system-info)
		(sep)
		(clock :screen screen)
	)
)

; Right side stuff
(defwidget sep []
	(box  :class "separator"
		(label :text "|")
	)
)
