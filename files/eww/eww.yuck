(include "./bar.yuck")

; Window for the bar. One instance per connected monitor, opened by
; scripts/sync-bars as `bar-<monitor name>`. `screen` is populated from the
; --screen flag and threaded down so each bar can report its own monitor
; (eww variables are global, so the widgets index per-monitor maps by name).
(defwindow bar [screen]
	:monitor screen
	:geometry (geometry
		:x "0%"
		:y "9px"
		:width "98%"
		:height "30px"
		:anchor "top center"
	)
	:stacking "fg"
	:reserve (struts :distance "40px" :side "top")
	:windowtype "dock"
	:wm-ignore false
	:exclusive true
	:focusable false

	(bar :screen screen)
)
