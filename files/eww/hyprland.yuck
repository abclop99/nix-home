; Hyprland workspaces module. `workspaces` is the global 1-10 list, each entry
; carrying the monitor that owns it ("" when the workspace does not exist);
; `active_workspaces` maps monitor name -> its active workspace id, so each bar
; highlights its own monitor rather than the focused one.
(deflisten workspaces :initial "[]" "bash ./scripts/get-workspaces")
(deflisten active_workspaces :initial "{}" "bash ./scripts/get-active-workspace")
(defwidget workspaces [screen]
	(eventbox :onscroll "bash ~/.config/eww/scripts/change-active-workspace {} ${active_workspaces?.[screen] ?: 1} ${screen}"
		(box  :space-evenly true
			; (label :text "${workspaces}${active_workspaces}" :visible false)
			(for workspace in workspaces
				(eventbox :onclick "hyprctl dispatch workspace ${workspace.id} > /dev/null"
									:class "workspace-entry ${workspace.id == (active_workspaces?.[screen] ?: 0) ? "current" : ""} ${workspace.monitor == "" ? "empty" : (workspace.monitor == screen ? "occupied" : "elsewhere")}"
					(label :text "${workspace.id}")
				)
			)
		)
	)
)

; Active widow title module. Maps monitor name -> the title of the window
; focused on that monitor, "" when its workspace is empty.
(deflisten window_titles :initial "{}" "bash ./scripts/get-window-title")
(defwidget active_window [screen]
	(box  :class "window_title"
		; Two limits, and each does a job the other cannot. :truncate ellipsizes,
		; which drops the label's *minimum* width to the ellipsis -- without it
		; the label demands its full natural width, centerbox squeezes the left
		; section below its own natural size, and the low workspace numbers get
		; clipped off the edge of the bar. But ellipsizing only yields space it
		; is forced to yield, and nothing forces it until the title meets the
		; systray, so on a wide monitor it still grows to fill the whole gap.
		; :limit-width caps the *natural* width at a character count. Dynamic
		; truncation still applies below that cap (show-truncated defaults on),
		; so a narrower monitor cuts sooner on its own. The count is a taste
		; setting -- raise it for more title, lower it for a quieter bar.
		(label :text "${window_titles?.[screen] ?: ""}" :truncate true :limit-width 60)
	)
)
