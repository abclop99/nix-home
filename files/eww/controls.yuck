; Both sliders need `screen`, for different reasons. Brightness needs it to
; know whether this bar's monitor is the one it can control at all; volume
; needs it only to know which bar is hovered, since it acts on the one default
; sink either way. Microphone has no revealer and no per-monitor state.
(defwidget controls [screen]
	(box  :class "module controls"
	      :space-evenly false
		(brightness :screen screen)
		(volume :screen screen)
		(microphone)
	)
)

(deflisten sound_info :initial '{"volume": "50", "muted": "false", "mic_muted": "false"}' "bash ./scripts/get-sound-info")

; Where the pointer is, as "<monitor>:<kind>" or "" for nowhere. Two variables,
; one per end, and each is written ONLY by its own widget -- that separation is
; the whole point. A popup fires hoverlost when it opens, before the pointer has
; ever been over it, so a single shared variable got cleared by the popup the
; instant the icon set it, and the popup blinked shut again while the pointer
; was still sitting on the icon. Split, that spurious event clears only
; pop_body, pop_icon still names the control, and close-control-popup keeps the
; window open. eww variables are global, so these double as the per-monitor key;
; a bare boolean would have driven every bar's popup at once.
(defvar pop_icon "")
(defvar pop_body "")

; Scripts are named by absolute path here, not `./scripts/...`. The relative
; form works for deflisten, whose cwd is the config dir, but event commands do
; not get that cwd -- hyprland.yuck's :onscroll already spells it out in full
; for the same reason.
; Shared by the bar and the popup, so the popup carries the same glyph and can
; be told apart from the brightness one at a glance. The two popups sit 13px
; apart and are 44px wide, so they overlap heavily and the glyph is what
; actually distinguishes them.
(defwidget volume-icon []
	(label :text {sound_info.muted ? "󰝟" : (sound_info.volume <= 33 ? "󰕿" : (sound_info.volume <= 66 ? "󰖀" : "󰕾") )})
	; 󰕾
)

; The popup's copy of the icon is the mute button. The bar's icon cannot be,
; because its click opens the popup -- but once the popup is open its glyph is
; a bigger target than the bar's and is already showing mute state, so mute
; lands back on a plain left-click where it started.
(defwidget volume-mute-button []
	(eventbox :class "icon mute"
	          :onclick "pamixer --toggle-mute"
	          :tooltip "${sound_info.muted ? 'Unmute' : 'Mute'}"
		(volume-icon)
	)
)

; One eventbox carrying both the hover and the click handlers. This was two
; nested ones, .volume outside for hover and .icon inside for clicks, and the
; merge is kept only because one widget is simpler than two -- NOT because the
; nesting was broken. It was blamed for :onhoverlost never firing; that was
; wrong, and the earlier revealer proves it, since it opened and closed on hover
; through exactly that nested structure. The real cause was eww reaping the
; close script (see scripts/close-control-popup). Do not cite nesting as a
; hazard on the strength of this comment.
;
; Opening is a click, closing is not: moving the pointer off both the icon and
; the popup dismisses it. Hover still writes pop_icon even though it no longer
; opens anything -- that is what tells close-control-popup the pointer is still
; on this control. Mute moves to right-click, since left-click is the opener.
;
; The click closes the sibling popup first, so the two controls on THIS bar can
; never both be open. It does not cover two bars: clicking volume on one monitor
; while the other monitor's volume popup is open leaves both until that one's
; pending close fires. Harmless and invisible -- the pointer cannot reach the
; second bar without having fired the first one's hoverlost -- but it is the
; race resolving correctly, not a guarantee.
;
; The click also asserts pop_icon rather than trusting the hover to have set it.
; The popup fires its own hoverlost as it opens; if pop_icon were empty at that
; moment the close it schedules would match neither variable and dismiss the
; popup 0.6s later with the pointer still on the icon. Reachable only if a click
; arrives with no preceding crossing -- a warped cursor does exactly that.
(defwidget volume [screen]
	(box :class "item"
		(eventbox :class "volume icon"
		          :onhover      "${EWW_CMD} update pop_icon=${screen}:volume"
		          :onhoverlost  "${EWW_CMD} update pop_icon=; bash ~/.config/eww/scripts/close-control-popup ${screen} volume"
		          :onclick      "${EWW_CMD} update pop_icon=${screen}:volume; ${EWW_CMD} close popup-${screen}-brightness > /dev/null 2>&1; ${EWW_CMD} open volume-popup --toggle --id popup-${screen}-volume --screen ${screen} --arg screen=${screen}"
		          :onrightclick "pamixer --toggle-mute"
					    :tooltip "Volume: ${sound_info.muted ? 'Muted' : sound_info.volume + '%'}"
			(volume-icon)
		)
	)
)

; :flipped puts the maximum at the top -- a GTK vertical range runs minimum-up
; by default, which reads backwards for a level.
(defwidget volume-popup-body [screen]
	(eventbox :class "popup-body"
	          :onhover     "${EWW_CMD} update pop_body=${screen}:volume"
	          :onhoverlost "${EWW_CMD} update pop_body=; bash ~/.config/eww/scripts/close-control-popup ${screen} volume"
		(box :class "popup volume"
		     :orientation "v"
		     :space-evenly false
			(scale :class "slider"
			       :value {sound_info.volume}
			       :onchange "pamixer --set-volume {}"
			       :orientation "v"
			       :flipped true
			       :max 101
			       :min 0
			)
			(volume-mute-button)
		)
	)
)

(defwidget microphone []
	(box :class "item"
		(eventbox :class "icon"
		          :onclick "pactl set-source-mute 0 toggle"
			(label :text "${sound_info.mic_muted ? "󰍭" : "󰍬" }")
		)
	)
)

; Backlight state keyed by the DRM connector that owns it, so each bar can ask
; whether it is drawn on the monitor this control would affect. Event-driven,
; so one variable serves both the slider -- which wants every change at once --
; and the icon, which stays correct even when brightness is changed by
; something that never touches the widget. That combination is what retired a
; fast gated poll plus a slow ungated one; see the script for the mechanism.
(deflisten backlight :initial "{}" "python3 ./scripts/get-brightness")

; A bare label, shared by the bar and the popup so the popup carries the same
; glyph. No eventbox of its own simply because it needs no click of its own --
; NOT because nesting is a hazard. Nesting was blamed once for :onhoverlost
; never firing. Measurement found the real cause elsewhere entirely (eww reaps
; the close script; see scripts/close-control-popup), which accounts for the
; symptom completely and leaves nothing for nesting to explain. Against it: the
; pre-popup revealer used exactly that nested pair and its hover worked. Do not
; resurrect the theory from this file.
(defwidget brightness-icon [pct]
	(label :text {pct <= 25 ? "󰃞" : (pct <= 50 ? "󰃟" : (pct <= 75 ? "󰃝" : "󰃠"))})
)

; Rendered only on the bar whose monitor owns a backlight. An external monitor
; has none -- it is driven over I2C with DDC/CI, not by the kernel backlight
; class -- so without this test its bar drew a slider that silently moved the
; laptop panel instead. Each lookup carries a default because eww evaluates
; attributes whether or not the box is visible.
(defwidget brightness [screen]
	; eww has no `null` literal, so the presence test is arithmetic: a monitor
	; with no entry elvis-defaults to 0, and a real device always reports a
	; positive max_brightness.
	(box :class "item"
	     :visible {(backlight?.[screen]?.max ?: 0) > 0}
		(eventbox :class "brightness icon"
		          :onhover     "${EWW_CMD} update pop_icon=${screen}:brightness"
		          :onhoverlost "${EWW_CMD} update pop_icon=; bash ~/.config/eww/scripts/close-control-popup ${screen} brightness"
		          :onclick     "${EWW_CMD} update pop_icon=${screen}:brightness; ${EWW_CMD} close popup-${screen}-volume > /dev/null 2>&1; ${EWW_CMD} open brightness-popup --toggle --id popup-${screen}-brightness --screen ${screen} --arg screen=${screen}"
			        :tooltip "Brightness: ${100 * (backlight?.[screen]?.value ?: 0) / (backlight?.[screen]?.max ?: 1)}%"
			(brightness-icon :pct {100 * (backlight?.[screen]?.value ?: 0) / (backlight?.[screen]?.max ?: 1)})
		)
	)
)

; Percent, with constant bounds, rather than the device's raw range. The raw
; form drew an empty slider: at window-open `backlight` is still {}, so :max
; evaluated to 1 + 1 while :min was 1, GTK clamped the incoming reading to 2,
; and re-setting :max afterwards does not lift a value already clamped down.
; The tooltip disagreed because it does its own arithmetic and never touches
; GTK's adjustment. Constant bounds cannot be wrong at any point in startup.
; brightnessctl truncates a fractional percentage, so no rounding is needed.
(defwidget brightness-popup-body [screen]
	(eventbox :class "popup-body"
	          :onhover     "${EWW_CMD} update pop_body=${screen}:brightness"
	          :onhoverlost "${EWW_CMD} update pop_body=; bash ~/.config/eww/scripts/close-control-popup ${screen} brightness"
		(box :class "popup brightness"
		     :orientation "v"
		     :space-evenly false
			(scale :class "slider"
			       :value {100 * (backlight?.[screen]?.value ?: 0) / (backlight?.[screen]?.max ?: 1)}
			       ; GTK emits value-changed when the scale's value is first set,
			       ; so every open issues one write before anything is dragged.
			       ; It is harmless because :value is the CURRENT reading, so the
			       ; write is a no-op -- NOT because of the "none" placeholder.
			       ; Through the UI that placeholder never fires: the popup opens
			       ; only from an icon that is hidden unless `backlight` has an
			       ; entry for this monitor, so -d always names the real device.
			       ; Keep it anyway -- `eww open brightness-popup --arg
			       ; screen=<a monitor with no backlight>` still reaches this, and
			       ; an empty -d makes brightnessctl swallow the next argument.
			       :onchange "brightnessctl -d ${backlight?.[screen]?.device ?: "none"} set {}% > /dev/null"
			       :orientation "v"
			       :flipped true
			       :max 101
			       :min 1
			)
			(brightness-icon :pct {100 * (backlight?.[screen]?.value ?: 0) / (backlight?.[screen]?.max ?: 1)})
		)
	)
)
